{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "types": [
      "vite/client",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@brftech/filex-app-ui": [
        "./vendor/filex-app-ui/filex-app-ui"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "vendor/blocksuite/*.d.ts",
    "vendor/filex-app-ui/*.d.ts"
  ]
}
